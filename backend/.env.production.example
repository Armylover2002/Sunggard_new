# ==============================================================================
# Production environment reference — KEY NAMES ONLY, no values.
#
# You do NOT upload this file, and you do NOT upload .env. On Render these keys
# live in the "sungguard-shared" environment group (created automatically by
# /render.yaml at the repo root); you fill the blank ones in the dashboard once.
#
# This file exists to answer "which keys must I fill in, and which must I leave
# alone" — the differences from your local .env are what matter.
# ==============================================================================

# ── Set by the platform, never by you ─────────────────────────────────────────
# NODE_ENV          -> render.yaml pins this to "production" per service.
#                      It is absent from .env on purpose: .env is your local
#                      dev file. Without it the code defaults to "development"
#                      (index.js), which leaks stack traces and turns mock OTP
#                      on. Never add it to .env.
# REDIS_URL         -> injected from the Key Value service via `fromService`.
# PORT              -> injected by Render; index.js reads it and falls back to
#                      7000 locally. Do not pin it in the dashboard.
# NODE_VERSION      -> pinned to 22 in the shared env group.
# PROCESS_ROLE      -> api | worker | scheduler, one per service.

# ── OTP: one variable, nothing else ───────────────────────────────────────────
# USE_REAL_SMS      unset  -> every OTP is 1234 and no SMS is sent. Works with
#                             zero config in every environment. This is the
#                             pre-launch setting; leave it unset for now.
#                   "true" -> random OTPs over SMS. Needs SMS_INDIA_HUB_* below.
#                             Set this one variable when you go live.
#
# Every OTP throttle has a generous in-code default (100 per window, no resend
# cooldown), so none of these are required. Set one only to tighten it:
#   per IP:        OTP_RATE_LIMIT_MAX, AUTH_RATE_LIMIT_MAX
#   per mobile+IP: OTP_SEND_RATE_LIMIT_MAX, OTP_VERIFY_RATE_LIMIT_MAX
#   per phone:     OTP_SEND_LIMIT_PER_WINDOW, OTP_VERIFY_LIMIT_PER_WINDOW,
#                  OTP_RESEND_COOLDOWN_SECONDS
#   seller signup: SELLER_OTP_* equivalents of the last group

# ── MUST NOT be set in production ─────────────────────────────────────────────
# USE_MOCK_OTP      No longer read anywhere. Delete it if it is still in your
#                   Render dashboard; USE_REAL_SMS is the only OTP switch.
# REDIS_ENABLED=false  Throws on boot in production (app/config/redis.js).
#                   render.yaml must pin REDIS_ENABLED to "true" with a valid
#                   REDIS_URL — that is the only Redis connection source now.
# BULLMQ_ENABLED=false Disables Bull queues/workers even though Redis stays up
#                   for caching/rate-limits. Leave unset (defaults to true)
#                   unless you deliberately want queues off in production.

# ── Differs from your local .env — change the value, do not copy ──────────────
FRONTEND_URL=           # not present locally at all. Required: drives CORS.
CORS_ALLOWED_ORIGINS=   # optional; overrides FRONTEND_URL when set

# ── Secrets to paste into the Render dashboard ────────────────────────────────
MONGO_URI=
JWT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=  # Dashboard > Settings > Webhooks. NOT the API key
                          # secret. Webhooks are refused while this is unset,
                          # which leaves payments confirmed only by the
                          # customer's own browser.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_INDIA_HUB_URL=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_GWID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_TEMPLATE_TEXT=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

FIREBASE_SERVICE_ACCOUNT=   # full service-account JSON, collapsed to one line
FIREBASE_DATABASE_URL=
# Data-only FCM for rider job offers, required for the native overlay/ring to
# fire on a killed app (a notification+data payload is absorbed by the OS
# tray and never reaches app code). Driver app's background handler already
# expects this shape, see incoming_parcel_service.dart.
FCM_DATA_ONLY_JOB_OFFERS=true

GOOGLE_MAPS_API_KEY=

# ── Tunables with sane defaults already in render.yaml ────────────────────────
# JWT_EXPIRES_IN, MAPS_RL_*, PICKUP_RADIUS_METERS,
# RETURN_WINDOW_MINUTES, DEFAULT_DELIVERY_TIMEOUT_MS,
# DELIVERY_BROADCAST_REQUIRE_VERIFIED, LOG_LEVEL, TRUST_PROXY,
# AUTO_CANCEL_INTERVAL_MS, PAYOUT_BATCH_INTERVAL_MS, ENABLE_PAYOUT_BATCH_JOB
# Override in the dashboard only if you need something other than the default.
